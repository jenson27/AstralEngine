  "cards": [
    {
      "dot": "cyan",
      "title": "Responsibility split",
      "items": [
        "BrowserApplication is the composition root: its direct renderer and platform links are setup wiring.",
        "BrowserRuntime owns lifecycle and frame callbacks. Engine owns fixed-step and animation-frame scheduling.",
        "SceneManager owns scene sessions. Each Scene owns its ECS data and phase scheduler.",
        "RenderSystem prepares render items; Engine calls the WebGPU renderer after render preparation."
      ]
    },
    {
